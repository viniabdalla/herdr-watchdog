#!/usr/bin/env python3
"""Mostra o ID de cada pane do Herdr (ex.: wZ:p1) na borda do pane.

  herdr-pane-ids run      # loop (o serviço systemd usa este)
  herdr-pane-ids once     # aplica uma vez
  herdr-pane-ids copy     # copia o ID do pane com foco (atalho prefix+y)
  herdr-pane-ids restore  # devolve os nomes originais e apaga o estado

Só fala com o socket local do Herdr (comando `herdr`). Sem rede.
O estado em ~/.local/state/herdr-pane-ids.json guarda o nome original de cada pane,
para distinguir rótulo automático de nome dado à mão.
"""
import json, os, subprocess, sys, time

STATE = os.path.expanduser("~/.local/state/herdr-pane-ids.json")
SEP = " · "
INTERVAL = 2.0


def herdr(*args):
    r = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=10)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or r.stdout.strip())
    return r.stdout


def panes():
    return json.loads(herdr("pane", "list"))["result"]["panes"]


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=1)
    os.replace(tmp, STATE)


def strip_id(pid, label):
    """Remove um prefixo de ID que já esteja no nome (ex.: de execução anterior)."""
    if not label:
        return None
    if label == pid:
        return None
    if label.startswith(pid + SEP):
        return label[len(pid + SEP):] or None
    return label


def apply(st):
    live = panes()
    ids = set()
    for p in live:
        pid, label = p["pane_id"], p.get("label")
        ids.add(pid)
        entry = st.get(pid)
        if entry and label == entry["auto"]:
            base = entry["base"]
        else:  # pane novo ou renomeado à mão
            base = strip_id(pid, label)
        want = pid  # só o ID do pane
        if want != label:
            herdr("pane", "rename", pid, want)
        st[pid] = {"auto": want, "base": base, "orig": entry["orig"] if entry else label}
    for pid in list(st):
        if pid not in ids:
            del st[pid]
    save(st)


def restore():
    st = load()
    live = {p["pane_id"]: p.get("label") for p in panes()}
    for pid, e in st.items():
        if pid in live and live[pid] == e["auto"]:
            orig = e.get("orig")
            if orig and strip_id(pid, orig):
                herdr("pane", "rename", pid, orig)
            else:
                herdr("pane", "rename", pid, "--clear")
    try:
        os.remove(STATE)
    except OSError:
        pass


def copy_focused():
    """Copia o ID do pane com foco para o clipboard do cliente (OSC 52 via Herdr)."""
    import base64
    snap = json.loads(herdr("api", "snapshot"))["result"]["snapshot"]
    pid = snap.get("focused_pane_id") or ""
    seq = "\033]52;c;" + base64.b64encode(pid.encode()).decode() + "\a"
    with open("/dev/tty", "w") as tty:
        tty.write(seq)
        tty.write(f"\n  {pid} copiado\n")
        tty.flush()
    time.sleep(0.7)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    if cmd == "copy":
        copy_focused()
    elif cmd == "restore":
        restore()
    elif cmd == "once":
        apply(load())
    elif cmd == "run":
        st = load()
        while True:
            try:
                apply(st)
            except Exception as e:  # Herdr fechado/reiniciando: tenta de novo
                print(f"herdr-pane-ids: {e}", file=sys.stderr, flush=True)
            time.sleep(INTERVAL)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
